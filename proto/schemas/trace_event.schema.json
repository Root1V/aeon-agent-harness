{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeon.dev/schemas/trace_event.schema.json",
  "title": "TraceEvent",
  "description": "OTel GenAI semantic-conventions-aligned span emitted by the runtime (OBS-001). Span tree: invoke_agent -> chat / execute_tool. Never carries chain-of-thought; rationale lives behind rationale_ref pointers only.",
  "type": "object",
  "additionalProperties": true,
  "required": ["trace_id", "span_id", "name", "kind", "start_time", "attributes"],
  "properties": {
    "trace_id": { "type": "string" },
    "span_id": { "type": "string" },
    "parent_span_id": { "type": ["string", "null"] },
    "name": { "type": "string", "enum": ["invoke_agent", "chat", "execute_tool", "context_assemble", "policy_check", "approval_wait"] },
    "kind": { "type": "string", "enum": ["INTERNAL", "CLIENT", "SERVER"] },
    "start_time": { "type": "string", "format": "date-time" },
    "end_time": { "type": ["string", "null"], "format": "date-time" },
    "attributes": {
      "type": "object",
      "description": "gen_ai.* attributes per OTel GenAI semantic conventions, plus aeon.* extensions.",
      "properties": {
        "gen_ai.system": { "type": "string" },
        "gen_ai.request.model": { "type": "string" },
        "gen_ai.usage.input_tokens": { "type": "integer" },
        "gen_ai.usage.output_tokens": { "type": "integer" },
        "gen_ai.evaluation.score": { "type": "number" },
        "aeon.run_id": { "type": "string" },
        "aeon.tenant_id": { "type": "string" },
        "aeon.idempotency_key": { "type": "string" }
      }
    }
  }
}
