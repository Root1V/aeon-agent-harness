# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# --- Cloud model providers (Model Gateway adapters, see roadmap §2.4 / MDL-003..005) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Local inference (MDL-006). Assumed OpenAI-compatible — see docs/adr/ADR-004. ---
# If your Prometheus inference deployment exposes a native API instead, this is where the
# base URL/auth for that adapter would go once implemented.
PROMETHEUS_INFERENCE_BASE_URL=http://localhost:8000/v1
PROMETHEUS_INFERENCE_API_KEY=

# --- Generic openai_compatible fallback (MDL-007), e.g. the dev vllm/ollama service ---
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
OPENAI_COMPATIBLE_API_KEY=not-needed

AEON_TENANT_ID=default
